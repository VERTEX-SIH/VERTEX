# ============================================
# VERTEX — Environment Variables Template
# Copy to backend/.env and frontend/.env.local
# NEVER commit actual values to version control
# ============================================

# --- REQUIRED (app will not start without these) ---
FIRMS_MAP_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=

# --- OPTIONAL (app starts without these, logs warnings) ---
EARTHDATA_USER=
EARTHDATA_PASS=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- App Config ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
